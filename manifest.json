{
  "manifest_version": 3,
  "name": "Gistly — Terms & Privacy Summarizer",
  "version": "1.1.0",
  "description": "Gistly quietly watches for Terms of Service, Privacy Policy and cookie-consent prompts and gives you a plain-language summary — without ever accepting or rejecting anything for you.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Gistly"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["detector.js", "extractor.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "activeTab"],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
  },
  "minimum_chrome_version": "116"
}
